FROM jookies/jasmin:0.11.0

# Overwrite jasmin's stock rest config with our env-driven one, then reinstall the
# package from its bundled source (/build has setup.py) so the change lands in
# site-packages. Used by BOTH the REST API (twistd) and the Celery batch worker.
WORKDIR /build
COPY config.py /build/jasmin/protocols/rest/config.py
RUN pip install .

WORKDIR /usr/jasmin
ENV PATH=$PATH:/usr/local/bin

# Default entrypoint runs the REST API; docker-compose overrides it for the
# celery worker service.
ENTRYPOINT ["twistd", "-n", "--pidfile=/tmp/twistd-web-restapi.pid", "web", "--wsgi=jasmin.protocols.rest.api"]
