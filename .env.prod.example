# cp .env.prod.example .env.prod

DOMAIN=oddjobs.tech

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me

DEBUG=False
ALLOWED_HOSTS=joyce.oddjobs.tech,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://joyce.oddjobs.tech,http://127.0.0.1:9003,http://localhost:9003

# Jasmin DLR → Joyce on the compose network (not the public hostname)
JOYCE_PUBLIC_BASE_URL=http://joyce:9000
JOYCE_CREDENTIALS_KEY=

GUNICORN_BIND=0.0.0.0:9000
GUNICORN_WORKERS=3
