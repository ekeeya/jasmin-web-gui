# cp .env.prod.example .env.prod

DOMAIN=oddjobs.tech

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=joyce
DB_USER=joyce
DB_PASSWORD=change-me

DEBUG=False
ALLOWED_HOSTS=joyce.oddjobs.tech
CSRF_TRUSTED_ORIGINS=https://joyce.oddjobs.tech

# Jasmin DLR → Joyce on the compose network (not the public hostname)
JOYCE_PUBLIC_BASE_URL=http://joyce:9000
JOYCE_CREDENTIALS_KEY=

GUNICORN_BIND=0.0.0.0:9000
GUNICORN_WORKERS=3
