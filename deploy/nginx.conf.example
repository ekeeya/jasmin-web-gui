# Sample host nginx (HTTP only). Copy and replace example.com:
#   cp deploy/nginx.conf.example deploy/nginx.conf
#   sudo cp deploy/nginx.conf /etc/nginx/sites-available/joyce
#   sudo ln -s /etc/nginx/sites-available/joyce /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d joyce.example.com \
#     -d sms.example.com -d sim.example.com
#
# No jasmin.* vhost. REST stays on 127.0.0.1:9010 for Joyce only.
# Jasmin SMPP (test SMSC) is TCP 2775 on the host IP. jcli is 127.0.0.1:8990.
#
# Loopback backends:
#   joyce       127.0.0.1:9003
#   jasmin REST 127.0.0.1:9010
#   jasmin HTTP 127.0.0.1:1401
#   smppsim     127.0.0.1:88

server {
    listen 80;
    listen [::]:80;
    server_name joyce.example.com;

    client_max_body_size 20m;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Static PDF from the git checkout. Adjust the alias to your clone path.
    # Copy into the Certbot listen 443 server as well.
    location = /workspace/settings/messaging-api-docs.pdf {
        alias /home/ekeeya/jasmin-web-gui/docs/joyce-messaging-api.pdf;
        default_type application/pdf;
        add_header Content-Disposition 'attachment; filename="joyce-messaging-api.pdf"';
        gzip off;
    }

    location = /docs/joyce-messaging-api.pdf {
        alias /home/ekeeya/jasmin-web-gui/docs/joyce-messaging-api.pdf;
        default_type application/pdf;
        add_header Content-Disposition 'attachment; filename="joyce-messaging-api.pdf"';
        gzip off;
    }

    location / {
        proxy_pass http://127.0.0.1:9003;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# /secure/* → Jasmin REST (host 9010). /send and the rest → classic HTTP API (1401).
server {
    listen 80;
    listen [::]:80;
    server_name sms.example.com;

    client_max_body_size 20m;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location /secure/ {
        proxy_pass http://127.0.0.1:9010;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization     $http_authorization;
        proxy_pass_header Authorization;
        proxy_read_timeout 120s;
    }

    location /send {
        proxy_pass http://127.0.0.1:1401;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:1401;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name sim.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:88;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
