[Unit]
Description=Joyce SMS stack (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
TimeoutStartSec=0
TimeoutStopSec=120
WorkingDirectory=@JOYCE_ROOT@
EnvironmentFile=-@JOYCE_ROOT@/.env.prod
# Foreground compose: if any container exits, stop the rest and fail this unit.
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --env-file .env.prod up --abort-on-container-exit --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml --env-file .env.prod down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
